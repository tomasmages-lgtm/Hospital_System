<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Successfully Appointment</title>
    <style>
            .appt-success {
            min-height: 100vh;
            display: grid;
            place-items: center;
            text-align: center;
            background: #f3f7f6;
            color: #14302b;
            font-family: "Segoe UI", Tahoma, sans-serif;
            }

            .appt-success__icon {
            font-size: 80px;
            line-height: 1;
            margin-bottom: 16px;
            }

            .appt-success__title {
            margin: 0;
            font-size: 1.8rem;
            }
    </style>
</head>
<body style="margin:0">
    <div class="appt-success">
        <div>
            <div class="appt-success__icon">✅</div>
            <h1 class="appt-success__title">Successfully Appointment</h1>
        </div>
    </div>
</body>
</html>